{
  "version": 2,
  "public": "client",
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth.js" },
    { "source": "/stats/:path*", "destination": "/api/stats.js" },
    { "source": "/health", "destination": "/api/health.js" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}