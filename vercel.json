{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "client" }
    },



    {
      "src": "api/**/*.js",
      "use": "@vercel/node"





    }
  ],
  "routes": [
    { "src": "/auth/(.*)", "dest": "/api/auth.js" },
    { "src": "/stats/(.*)", "dest": "/api/stats.js" },
    { "src": "/health", "dest": "/api/health.js" },
    { "src": "/(.*)", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ]
}