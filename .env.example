# Environment Variables for Render/Vercel Deployment
# Add these in your hosting dashboard (Render/Vercel) > Environment Variables

# ============ REQUIRED ============

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ============ OPTIONAL ============

# SMTP Configuration (for sending OTP emails)
# Without these, OTPs will be logged to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Firebase (OPTIONAL - only needed if you want Firebase tokens)
# Option 1: Individual vars (recommended - easier to paste)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n

# Option 2: Full JSON (alternative - harder to paste correctly)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Frontend URL (auto-detected on Render, set manually on Vercel)
FRONTEND_URL=https://your-app.onrender.com

# Node Environment
NODE_ENV=production
