# Environment Variables for Netlify Deployment
# Add these in Netlify Dashboard > Site settings > Environment variables

# ============ REQUIRED ============

# App URL (your deployed Netlify URL)
APP_URL=https://your-site.netlify.app
FRONTEND_URL=https://your-site.netlify.app

# ============ EMAIL (Resend) ============

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email sender address (must be from verified domain in Resend)
# Free tier: use noreply@resend.dev for testing
EMAIL_FROM=KRMU Green <noreply@your-domain.com>

# ============ FIREBASE ============

# Option 1: Individual vars (recommended - easier to set)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n

# Option 2: Full JSON (alternative - use if individual vars don't work)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
