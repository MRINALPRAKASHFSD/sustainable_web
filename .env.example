# Environment Variables for Render/Vercel/Netlify Deployment
# Add these in your hosting dashboard (Render/Vercel/Netlify) > Environment Variables

# ============ REQUIRED ============

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# App URL (for email link redirects)
APP_URL=https://your-app.vercel.app

# ============ EMAIL LINK AUTH (Resend) ============

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email sender address (must be from verified domain in Resend)
# Free tier: use noreply@resend.dev for testing
EMAIL_FROM=KRMU Green <noreply@your-domain.com>

# ============ OPTIONAL ============

# SMTP Configuration (for OTP emails - legacy)
# Without these, OTPs will be logged to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Firebase (for authentication)
# Option 1: Individual vars (recommended - easier to paste)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n

# Option 2: Full JSON (alternative - harder to paste correctly)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Frontend URL (auto-detected on Render, set manually on Vercel)
FRONTEND_URL=https://your-app.onrender.com

# Node Environment
NODE_ENV=production
